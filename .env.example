# DroidForenX Environment Configuration
# Copy to .env and fill in. NEVER commit real keys - .env is git-ignored.

DROIDFORENX_DEBUG=false
DROIDFORENX_DB_PATH=droidforenx.db
# Explicit path to the adb binary. Leave empty to auto-detect: the bundled
# copy in tools/platform-tools/ first, then adb on PATH.
# Windows example: DROIDFORENX_ADB_PATH=tools\platform-tools\adb.exe
# Linux example:   DROIDFORENX_ADB_PATH=/usr/lib/android-sdk/platform-tools/adb
DROIDFORENX_ADB_PATH=
DROIDFORENX_LOG_LEVEL=INFO

# Where per-case evidence is stored.
# Defaults to ~/.droidforenx/evidence when unset.
# DROIDFORENX_EVIDENCE_ROOT=evidence

# --- Assistant (optional) ---
# The assistant is a chat drawer in the corner of the window. Its transcript is
# stored per case in the examiner's profile, never in the case folder, and never
# enters the evidence chain. See README "Assistant".

# OpenRouter API key. Get one at https://openrouter.ai/keys
# Preferred: paste it once under the drawer's gear icon; it is then stored
# DPAPI-encrypted at %LOCALAPPDATA%\DroidForenX\assistant.key. A value here
# takes precedence over the stored key, which is convenient for testing.
OPENROUTER_API_KEY=

# The model chain is fixed in desktop/core/ai_assistant.py:
#   google/gemma-3-4b-it -> meta-llama/llama-3.1-8b-instruct
# and is intentionally not configurable.