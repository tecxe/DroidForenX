# DroidForenX Environment Configuration
# Copy to .env and fill in. NEVER commit real keys - .env is git-ignored.

DROIDFORENX_DEBUG=false
DROIDFORENX_DB_PATH=droidforenx.db
# Explicit path to the adb binary. Leave empty to auto-detect: the bundled
# copy in tools/platform-tools/ first, then adb on PATH.
# Windows example: DROIDFORENX_ADB_PATH=tools\platform-tools\adb.exe
# Linux example:   DROIDFORENX_ADB_PATH=/usr/lib/android-sdk/platform-tools/adb
DROIDFORENX_ADB_PATH=
DROIDFORENX_LOG_LEVEL=INFO

# Where per-case evidence is stored.
# Defaults to ~/.droidforenx/evidence when unset.
# DROIDFORENX_EVIDENCE_ROOT=evidence

# --- AI assist layer ---
# The AI layer NEVER writes to the evidence chain. Its output is stored in a
# separate ai_assist store and is excluded from the evidentiary Findings
# section. See README "AI Assist" for the provenance and data-handling rules.

# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Master switch for AI features. Cases may also opt out individually.
DROIDFORENX_AI_ENABLED=false

# Primary and fallback model chain.
DROIDFORENX_AI_MODEL=meta-llama/llama-3.1-8b-instruct
DROIDFORENX_AI_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free

# Strip phone numbers, emails and other PII before any content leaves the host.
DROIDFORENX_AI_REDACT=true

# Per-call token ceiling to bound cost and payload size.
DROIDFORENX_AI_MAX_TOKENS_PER_CALL=4000