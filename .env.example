# DroidForenX - environment variables template
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DB_NAME=droidforenx
DB_USER=droidforenx
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Forensics storage (absolute paths recommended) ---
# EVIDENCE_ROOT=/path/to/evidence
# REPORT_ROOT=/path/to/reports
